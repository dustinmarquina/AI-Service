# Copy this file to .env and fill in real values locally.
# Do not commit secrets.

# RabbitMQ Configuration
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=

# RabbitMQ Exchanges
RABBITMQ_EXCHANGE=
RABBITMQ_TRANSACTION_EXCHANGE=

# Consumer Queues
RABBITMQ_CONSUMER_QUEUE=
RABBITMQ_CONSUMER_ROUTING_KEY=
RABBITMQ_ADDITIONAL_QUEUES=
RABBITMQ_ADDITIONAL_ROUTING_KEYS=

# Producer Queue
RABBITMQ_PRODUCER_QUEUE=
RABBITMQ_PRODUCER_ROUTING_KEY=

# Database Configuration
MONGO_URI=
POSTGRES_URI=

# Ollama Configuration
OLLAMA_API_KEY=
OLLAMA_LOCAL_HOST=http://localhost:11434

# Groq Configuration
groq_api_key=
GROQ_API_KEY=

# 9router Configuration
9router_api_base_url=
9router_api_key=

# Transaction API Configuration
TRANSACTION_API_TOKEN=
TRANSACTION_USER_ID=
JWKS_URI=
TRANSACTION_API_URL=
CATEGORY_API_URL=
REPORT_API_URL=

# Application Settings
LOG_LEVEL=INFO
